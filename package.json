{
  "name": "pps-counter",
  "version": "0.1.0",
  "license": "MIT",
  "module": "index.ts",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist/index.js",
    "dist/tui.js",
    "dist/package.json",
    "README.md",
    "CONTEXT.md",
    "docs/adr"
  ],
  "scripts": {
    "build": "bun build index.ts tui.ts --outdir=dist --target=node --external=@opencode-ai/plugin --external=@opencode-ai/plugin/tui --external=@opentui/solid --external=solid-js --external=@opentui/core && printf '{\"type\":\"module\"}\\n' > dist/package.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ index.ts tui.ts",
    "check": "bun run typecheck && bun run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@opentui/core": "^0.2.10",
    "@opentui/keymap": "^0.2.10",
    "@types/bun": "latest",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^7.0.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.50",
    "@opentui/solid": "^0.2.10",
    "solid-js": "1.9.12"
  }
}
